# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Note: If no local MongoDB is detected, IMovies automatically launches an in-memory database with pre-seeded data
MONGO_URI=mongodb://localhost:27017/imovies

# Authentication & Security
JWT_SECRET=imovies_super_secure_jwt_secret_key_2026_cinema_access
JWT_EXPIRES_IN=7d
PAYMENT_KEY=imovies_cryptographic_payment_signing_key_2026

# Geolocation & Regional Configuration
DEFAULT_CITY=Bhilai
TZ=Asia/Kolkata

# Live Movie Catalog Sync (Optional TMDB API)
# Leave empty to use the 18 curated movies loaded from server/seed/currentMovies.json
TMDB_API_KEY=
TMDB_REGION=IN

# Payment Gateway Configuration
# Mode 1: Razorpay Test Mode (Fill keys to use real Razorpay sandbox modal)
# Mode 2: Built-in Simulated Gateway (Leave empty; works 100% out-of-the-box with 0 keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Custom Ticket QR Image Asset:
# Drop your custom QR code image file into: client/public/assets/custom-ticket-qr.png
# It will automatically be rendered sharp, responsive, and included in PDF ticket downloads.
