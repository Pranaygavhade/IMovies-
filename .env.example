# ==============================================================================
# iMovies Root Environment Variables Template
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# NEVER commit your actual .env file or production secret keys to version control.
# ==============================================================================

# Node Environment ('production' on Vercel, 'development' locally)
NODE_ENV=production

# Server Port (Used only for local standalone execution, ignored on Vercel)
PORT=5000

# Client Application URL (For CORS and redirect handling)
CLIENT_URL=https://your-imovies-domain.vercel.app

# Remote MongoDB Atlas Connection URI (REQUIRED in production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/imovies?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string >= 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Payment Currency
PAYMENT_CURRENCY=INR

# Razorpay Production / Test Credentials
# Set real credentials in Vercel to activate real payments
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# TMDB Movie Catalog Integration (Optional: Live movie catalog sync)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_REGION=IN

# Regional & Geolocation Configuration
DEFAULT_CITY=Bhilai
TZ=Asia/Kolkata
