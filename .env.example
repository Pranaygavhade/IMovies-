# ==============================================================
# IMovies – Movie ticket booking made simple
# Root Environment Configuration Template
# ==============================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas or local MongoDB; MongoMemoryServer fallback is included)
MONGO_URI=mongodb://localhost:27017/imovies

# Authentication
JWT_SECRET=imovies_super_secret_jwt_key_2026_cinema_production
JWT_EXPIRES_IN=7d

# Payment Gateway (Optional: If empty, IMovies uses the built-in Simulated Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Notifications (Optional: If empty, notifications will log to console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=tickets@imovies.com

# Client URL (for CORS during separated dev; optional in single-deploy)
CLIENT_URL=http://localhost:5173
